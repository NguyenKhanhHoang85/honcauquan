rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMenuItem(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.category is string && data.category.size() <= 64 &&
             data.price is number && data.price >= 0 &&
             data.isAvailable is bool;
    }

    function isValidTable(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 64 &&
             data.area is string && data.area.size() <= 64 &&
             data.capacity is number && data.capacity > 0 &&
             data.status is string && data.status.size() <= 32;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderCode is string && data.orderCode.size() <= 32 &&
             data.orderType is string && data.orderType.size() <= 32 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.finalAmount is number && data.finalAmount >= 0 &&
             data.paymentStatus is string && data.paymentStatus.size() <= 32 &&
             data.orderStatus is string && data.orderStatus.size() <= 32;
    }

    function isValidReservation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 128 &&
             data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 32 &&
             data.guestCount is number && data.guestCount > 0 &&
             data.date is string && data.date.size() <= 32 &&
             data.time is string && data.time.size() <= 32 &&
             data.status is string && data.status.size() <= 32;
    }

    function isValidStaffAccount(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 64 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 128 &&
             data.role is string && (data.role == 'manager' || data.role == 'staff' || data.role == 'customer');
    }

    function isValidRestaurantSettings(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.hotline is string && data.hotline.size() <= 32 &&
             data.address is string && data.address.size() <= 256 &&
             data.bankId is string && data.bankId.size() <= 32 &&
             data.accountNo is string && data.accountNo.size() <= 64 &&
             data.accountName is string && data.accountName.size() <= 128 &&
             data.defaultVatRate is number &&
             data.isVatEnabled is bool &&
             data.defaultSurcharge is number &&
             data.primaryColor is string && data.primaryColor.size() <= 32 &&
             data.autoSyncGoogleSheets is bool;
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.staffName is string && data.staffName.size() > 0 && data.staffName.size() <= 128 &&
             data.staffRole is string && data.staffRole.size() <= 32 &&
             data.actionType is string && data.actionType.size() <= 64 &&
             data.details is string && data.details.size() <= 1000;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Menu items: readable by all visitors; writable with validation
    match /menuItems/{itemId} {
      allow read: if true;
      allow create, update: if isValidId(itemId) && isValidMenuItem(request.resource.data);
      allow delete: if isValidId(itemId);
    }

    // Restaurant tables: real-time seating and status
    match /tables/{tableId} {
      allow read: if true;
      allow create, update: if isValidId(tableId) && isValidTable(request.resource.data);
      allow delete: if isValidId(tableId);
    }

    // Orders: dine-in and takeaway orders
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow delete: if isValidId(orderId);
    }

    // Reservations: table bookings
    match /reservations/{reservationId} {
      allow read: if true;
      allow create, update: if isValidId(reservationId) && isValidReservation(request.resource.data);
      allow delete: if isValidId(reservationId);
    }

    // Staff accounts: credentials and personnel profiles
    match /staffAccounts/{accountId} {
      allow read: if true;
      allow create, update: if isValidId(accountId) && isValidStaffAccount(request.resource.data);
      allow delete: if isValidId(accountId);
    }

    // Restaurant settings: branding, payment info, receipt config
    match /restaurantSettings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isValidRestaurantSettings(request.resource.data);
      allow delete: if isValidId(settingId);
    }

    // Staff audit logs: action trail
    match /auditLogs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId) && isValidAuditLog(request.resource.data);
      allow delete: if isValidId(logId);
    }
  }
}
